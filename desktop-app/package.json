{
  "name": "redline",
  "version": "0.0.1-beta",
  "description": "A real-time visual feedback tool for AI-driven frontend development. Triggered by a hotkey, it lets you draw and annotate UI/UX changes directly on your screen—from layout fixes to styling tweaks. The Electron menu-bar app and built-in MCP server feed annotated screenshots straight to Claude or any AI agent to apply code changes instantly.",
  "type": "module",
  "main": "app/main.js",
  "bin": {
    "redline-mcp": "mcp/server.js"
  },
  "scripts": {
    "app": "electron .",
    "mcp": "node mcp/server.js",
    "mac:build": "electron-builder --mac --config build/local-app.config.cjs",
    "mac:install": "npm run mac:build && rm -rf /Applications/Redline.app && cp -R dist/local/mac-arm64/Redline.app /Applications/ && open /Applications/Redline.app",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "claude:command": "node -e \"const fs=require('fs'),os=require('os'),p=require('path');const d=p.join(os.homedir(),'.claude','commands');fs.mkdirSync(d,{recursive:true});fs.copyFileSync('claude/commands/redline.md',p.join(d,'redline.md'));console.log('Installed /redline for Claude Code →',p.join(d,'redline.md'))\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT",
  "author": "S Islam Rafi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sislamrafi/redline.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "ai-agents",
    "electron",
    "screenshot-annotation",
    "frontend",
    "ui",
    "developer-tools"
  ],
  "build": {
    "appId": "com.redline.app",
    "productName": "Redline",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "app/**",
      "shared/**",
      "mcp/**",
      "claude/**"
    ],
    "npmRebuild": false,
    "afterPack": "build/after-pack.cjs",
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureUsageDescription": "Redline captures your screen so you can mark up UI changes.",
        "NSAppleEventsUsageDescription": "Redline reads the frontmost window title and browser URL to give context to your markups."
      }
    },
    "dmg": {
      "title": "Redline ${version}"
    },
    "win": {
      "icon": "build/icon/icon-flat-1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "linux": {
      "icon": "build/icon/icon-flat-1024.png",
      "category": "Development",
      "maintainer": "S Islam Rafi",
      "synopsis": "Mark up your screen and send the changes to your AI coding agent",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "asar": false
  },
  "homepage": "https://github.com/sislamrafi/redline"
}
